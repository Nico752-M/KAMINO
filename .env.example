# Copia este archivo como .env y llena los valores. NUNCA subas .env a Git.
APP_ENV=development
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DB_USER=CEA_WEB
DB_PASSWORD=cambia-esto
DB_DSN=kamino_low
DB_SCHEMA=CEA_APP
DB_POOL_SIZE=5
# Solo para el script administrativo local; si se deja vacío, pedirá la contraseña.
DB_OWNER_USER=CEA_APP
DB_OWNER_PASSWORD=
WALLET_PASSWORD=contraseña-del-wallet
WALLET_DIR=./Wallet
# Para Vercel, cargar como variables secretas desde ewallet.pem y tnsnames.ora.
WALLET_PEM_B64=
WALLET_TNS_B64=
TRUST_PROXY=0
